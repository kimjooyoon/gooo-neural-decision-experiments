package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body092(Integer) -> Integer computes "if (input < 7) {\n\tif (input == 6) {\n\t\treturn (input + 7)\n\t} else {\n\t\treturn (input * 4)\n\t}\n} else {\n\treturn (input - 2)\n}"
