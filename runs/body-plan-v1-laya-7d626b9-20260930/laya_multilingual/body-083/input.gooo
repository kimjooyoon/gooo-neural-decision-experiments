package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body083(Integer) -> Integer computes "if (input < 7) {\n\tif (input == 7) {\n\t\treturn (input + 5)\n\t} else {\n\t\treturn (input * 4)\n\t}\n} else {\n\treturn (input - 3)\n}"
