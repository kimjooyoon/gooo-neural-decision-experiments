package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body087(Integer) -> Integer computes "if (input < 17) {\n\tif (input <= 17) {\n\t\treturn (input + 9)\n\t} else {\n\t\treturn (input * 2)\n\t}\n} else {\n\treturn (input - 2)\n}"
