package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body091(Integer) -> Integer computes "if (input < -17) {\n\tif (input <= -17) {\n\t\treturn (input + 6)\n\t} else {\n\t\treturn (input * 3)\n\t}\n} else {\n\treturn (input - 1)\n}"
