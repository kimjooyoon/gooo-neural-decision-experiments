package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body096(Integer) -> Integer computes "if (input <= 17) {\n\tif (input < 16) {\n\t\treturn (input + 4)\n\t} else {\n\t\treturn (input * 2)\n\t}\n} else {\n\treturn (input - 1)\n}"
