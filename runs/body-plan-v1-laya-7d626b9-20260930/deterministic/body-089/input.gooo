package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body089(Integer) -> Integer computes "if (input < 0) {\n\tif (input <= 0) {\n\t\treturn (input + 4)\n\t} else {\n\t\treturn (input * 4)\n\t}\n} else {\n\treturn (input - 4)\n}"
