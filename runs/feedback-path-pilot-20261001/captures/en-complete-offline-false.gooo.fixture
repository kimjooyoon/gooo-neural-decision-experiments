package pathstudy
namespace pathstudy
entity Integer id "pathstudy://entity/integer"
activity ConditionalAssign(Integer) -> Integer computes "package bodyplan\nnamespace bodyplan\n\nentity Integer id \"bodyplan://entity/integer\"\nentity Boolean id \"bodyplan://entity/boolean\"\n\nactivity ConditionalAssign(Integer) -> Integer computes \"let left = (input + 5)\\nlet right = (input - 10)\\nlet guard = (0 < input)\\nlet guard_alt = (input <= 5)\\nguard = (guard && guard_alt)\\nif guard {\\n\\tleft = (input - 10)\\n} else {\\n\\tright = (input + 5)\\n}\\nreturn (left + right)\"\n"
