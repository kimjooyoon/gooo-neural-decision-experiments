package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body084(Integer) -> Integer computes "if (input < 1) {\n\tif (input <= 0) {\n\t\treturn (input + 6)\n\t} else {\n\t\treturn (input * 2)\n\t}\n} else {\n\treturn (input - 4)\n}"
