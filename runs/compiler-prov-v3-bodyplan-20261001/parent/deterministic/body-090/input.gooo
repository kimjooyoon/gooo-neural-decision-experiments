package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body090(Integer) -> Integer computes "if (input <= -3) {\n\tif (input < -4) {\n\t\treturn (input + 5)\n\t} else {\n\t\treturn (input * 2)\n\t}\n} else {\n\treturn (input - 5)\n}"
