package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body082(Integer) -> Integer computes "if (input < -17) {\n\tif (input <= -18) {\n\t\treturn (input + 4)\n\t} else {\n\t\treturn (input * 3)\n\t}\n} else {\n\treturn (input - 2)\n}"
