package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body093(Integer) -> Integer computes "if (input <= 1) {\n\tif (input <= 1) {\n\t\treturn (input + 8)\n\t} else {\n\t\treturn (input * 2)\n\t}\n} else {\n\treturn (input - 3)\n}"
