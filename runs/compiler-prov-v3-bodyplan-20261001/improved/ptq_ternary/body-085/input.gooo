package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body085(Integer) -> Integer computes "if (input <= -1) {\n\tif (input == -1) {\n\t\treturn (input + 7)\n\t} else {\n\t\treturn (input * 3)\n\t}\n} else {\n\treturn (input - 5)\n}"
