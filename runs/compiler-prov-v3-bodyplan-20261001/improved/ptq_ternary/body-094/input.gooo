package bodyplan
namespace bodyplan

entity Integer id "bodyplan://entity/integer"
entity Boolean id "bodyplan://entity/boolean"

activity Body094(Integer) -> Integer computes "if (input <= -1) {\n\tif (input <= -2) {\n\t\treturn (input + 9)\n\t} else {\n\t\treturn (input * 3)\n\t}\n} else {\n\treturn (input - 4)\n}"
