  "changes": [
    {
      "coverage": [
        "central JSON scanner test",
        "model Load metadata test",
        "CLI execute handler test",
        "compiled CLI process reproduction"
      ],
      "finding": "raw invalid UTF-8 was silently normalized by encoding/json before the feature extractor could reject it",
      "fix": "RejectDuplicateJSONKeys now validates raw bytes with utf8.Valid before JSON tokenization"
    },
    {
      "coverage": [
        "BuildTypedBinary",
        "AssembleGoExpression",
        "ordinary ASCII names including _private"
      ],
      "finding": "ASCII identifier check accepted Go keywords and the blank identifier",
      "fix": "identifier validation rejects token.IsKeyword names and the exact name _ while retaining the existing ASCII-only policy"
    },
    {
      "coverage": [
        "positive and negative finite-weight hidden overflow",
        "finite-weight output-logit overflow",
        "finite-temperature calibration overflow"
      ],
      "finding": "finite float32 weights or a finite small temperature can overflow intermediate inference values",
      "fix": "PredictInto checks hidden activations before ReLU, output logits, calibrated logits and probabilities for nonfinite values; failed predictions leave zero output"
    }
  ],
